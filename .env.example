# Rice Age Portal — environment template.
# Copy to .env for local development:  cp .env.example .env
# Placeholders only. Never commit real secrets, device credentials or production values.

# ---------------------------------------------------------------- application
ENVIRONMENT=development
DEBUG=true
APP_SECRET_KEY=dev-only-change-me
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------- database
POSTGRES_DB=rice_age
POSTGRES_USER=rice_age
POSTGRES_PASSWORD=replace-with-local-dev-password
POSTGRES_PORT=5432
# Local processes use localhost; the Compose backend overrides this to host "db".
DATABASE_URL=postgresql+psycopg://rice_age:replace-with-local-dev-password@localhost:5432/rice_age
DATABASE_ECHO=false

# ---------------------------------------------------------------- auth / sessions
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------- HTTP / CORS
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- file storage
# local = filesystem adapter (development only); s3 = private S3-compatible bucket.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Production object storage — leave empty locally.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_USE_PATH_STYLE=true

# ---------------------------------------------------------------- upload limits
# PROVISIONAL values for local development only. Final limits, allowed formats and
# mandatory attachments are pending stakeholder confirmation (decision register
# DR-005, DR-006, DR-007). Do not present these as agreed business rules.
MAX_REPORT_BYTES=26214400
MAX_IMAGE_BYTES=15728640
MAX_SCAN_PAYLOAD_BYTES=1048576

# ---------------------------------------------------------------- frontend
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:8000
